        (flymake-error ((,class (:underline (:style wave :color ,(c 'red))))))
        (flymake-warning ((,class (:underline (:style wave :color ,(c 'yellow))))))
        (flymake-note ((,class (:underline (:style wave :color ,(c 'cyan))))))
        (flycheck-error ((,class (:underline (:style wave :color ,(c 'red))))))
        (flycheck-warning ((,class (:underline (:style wave :color ,(c 'yellow))))))
        (flycheck-info ((,class (:underline (:style wave :color ,(c 'cyan))))))
        (flycheck-fringe-error ((,class (:foreground ,(c 'red)))))
        (flycheck-fringe-warning ((,class (:foreground ,(c 'yellow)))))
        (flycheck-fringe-info ((,class (:foreground ,(c 'cyan)))))

        ;; Dired
        (dired-directory ((,class (:foreground ,(c 'blue)))))
        (dired-symlink ((,class (:foreground ,(c 'cyan)))))
        (dired-marked ((,class (:foreground ,(c 'magenta) :weight bold))))
