        (fill-column-indicator ((,class (:foreground ,(c 'bg_2)))))
        (display-fill-column-indicator-face ((,class (:foreground ,(c 'bg_2)))))

        ;; Font lock (Vim syntax groups)
        (font-lock-comment-face ((,class (:foreground ,(c 'dim_0) :slant italic))))
        (font-lock-comment-delimiter-face ((,class (:inherit font-lock-comment-face))))
        (font-lock-doc-face ((,class (:foreground ,(c 'dim_0) :slant italic))))
        (font-lock-doc-markup-face ((,class (:foreground ,(c 'violet)))))
        (font-lock-string-face ((,class (:foreground ,(c 'cyan)))))
        (font-lock-constant-face ((,class (:foreground ,(c 'cyan)))))
        (font-lock-number-face ((,class (:foreground ,(c 'cyan)))))
        (font-lock-keyword-face ((,class (:foreground ,(c 'br_yellow)))))
        (font-lock-builtin-face ((,class (:foreground ,(c 'br_yellow)))))
        (font-lock-type-face ((,class (:foreground ,(c 'green)))))
        (font-lock-function-name-face ((,class (:foreground ,(c 'br_blue)))))
        (font-lock-function-call-face ((,class (:foreground ,(c 'br_blue)))))
        (font-lock-variable-name-face ((,class (:foreground ,(c 'br_blue)))))
        (font-lock-variable-use-face ((,class (:foreground ,(c 'fg_0)))))
