(defun selenized-variable-specs (palette variant)
  "Return theme variable specs for PALETTE and VARIANT."
  (cl-flet ((c (name)
              (or (alist-get name palette)
                  (error "Unknown Selenized color: %S" name))))
    `((frame-background-mode ',variant)
      (ansi-color-names-vector
       [,(c 'bg_1) ,(c 'red) ,(c 'green) ,(c 'yellow)
        ,(c 'blue) ,(c 'magenta) ,(c 'cyan) ,(c 'dim_0)]))))

