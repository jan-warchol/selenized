        (smerge-base ((,class (:background ,(c 'bg_1) :extend t))))
        (smerge-markers ((,class (:foreground ,(c 'dim_0) :background ,(c 'bg_2) :extend t))))
        (smerge-refined-added ((,class (:foreground ,(c 'br_green) :background ,(c 'bg_2)))))
        (smerge-refined-removed ((,class (:foreground ,(c 'br_red) :background ,(c 'bg_2)))))
