        (compilation-warning ((,class (:foreground ,(c 'yellow)))))
        (compilation-info ((,class (:foreground ,(c 'green)))))
        (compilation-line-number ((,class (:foreground ,(c 'dim_0)))))
        (compilation-column-number ((,class (:foreground ,(c 'dim_0)))))
        (compilation-mode-line-exit ((,class (:foreground ,(c 'green) :weight bold))))
        (compilation-mode-line-fail ((,class (:foreground ,(c 'red) :weight bold))))
        (compilation-mode-line-run ((,class (:foreground ,(c 'yellow)))))

