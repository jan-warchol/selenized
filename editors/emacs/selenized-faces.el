;;; Commentary:

;; Shared face and theme-variable specs.  Syntax colors follow the Vim
;; highlight groups: yellow keywords, cyan constants, green types,
;; bright-blue identifiers.

;;; Code:

(require 'cl-lib)

(defun selenized-face-specs (palette)
  "Return theme face specs for PALETTE."
  (cl-flet ((c (name)
              (or (alist-get name palette)
                  (error "Unknown Selenized color: %S" name))))
    (let ((class t))
      `(
        ;; Basic
        (default ((,class (:foreground ,(c 'fg_0) :background ,(c 'bg_0)))))
        (cursor ((,class (:background ,(c 'fg_1)))))
        (fringe ((,class (:foreground ,(c 'dim_0) :background ,(c 'bg_1)))))
        (highlight ((,class (:background ,(c 'bg_1)))))
        (hl-line ((,class (:background ,(c 'bg_1) :extend t))))
        (region ((,class (:background ,(c 'bg_2) :extend t))))
        (secondary-selection ((,class (:background ,(c 'bg_2) :extend t))))
        (minibuffer-prompt ((,class (:foreground ,(c 'br_yellow) :weight bold))))
        (vertical-border ((,class (:foreground ,(c 'dim_0)))))
        (window-divider ((,class (:foreground ,(c 'dim_0)))))
        (window-divider-first-pixel ((,class (:foreground ,(c 'dim_0)))))
        (window-divider-last-pixel ((,class (:foreground ,(c 'dim_0)))))
        (internal-border ((,class (:background ,(c 'bg_0)))))
        (link ((,class (:foreground ,(c 'violet) :underline t))))
        (link-visited ((,class (:foreground ,(c 'magenta) :underline t))))
        (button ((,class (:foreground ,(c 'violet) :underline t))))
        (shadow ((,class (:foreground ,(c 'dim_0)))))
        (success ((,class (:foreground ,(c 'green)))))
        (warning ((,class (:foreground ,(c 'yellow)))))
        (error ((,class (:foreground ,(c 'red) :weight bold))))
        (escape-glyph ((,class (:foreground ,(c 'red)))))
        (homoglyph ((,class (:foreground ,(c 'red)))))
        (nobreak-space ((,class (:foreground ,(c 'red) :underline t))))
        (trailing-whitespace ((,class (:background ,(c 'red)))))
        (tooltip ((,class (:foreground ,(c 'fg_0) :background ,(c 'bg_1)))))
        (help-key-binding ((,class (:foreground ,(c 'br_yellow)
                                                :background ,(c 'bg_1)
                                                :box (:line-width 1 :color ,(c 'bg_2))))))

        ;; Search and paren matching
        (isearch ((,class (:foreground ,(c 'bg_0) :background ,(c 'orange) :weight bold))))
        (isearch-fail ((,class (:foreground ,(c 'fg_1) :background ,(c 'red)))))
        (lazy-highlight ((,class (:foreground ,(c 'bg_0) :background ,(c 'yellow)))))
        (match ((,class (:foreground ,(c 'bg_0) :background ,(c 'yellow)))))
        (show-paren-match ((,class (:foreground ,(c 'br_yellow)
                                                :background ,(c 'bg_2)
                                                :weight bold))))
        (show-paren-mismatch ((,class (:foreground ,(c 'fg_1)
                                                   :background ,(c 'red)
                                                   :weight bold))))

        ;; Mode line, header, tabs
        (mode-line ((,class (:foreground ,(c 'bg_0)
                                         :background ,(c 'fg_0)
                                         :box nil))))
        (mode-line-inactive ((,class (:foreground ,(c 'dim_0)
                                                  :background ,(c 'bg_2)
                                                  :box nil))))
        (mode-line-buffer-id ((,class (:weight bold))))
        (mode-line-highlight ((,class (:foreground ,(c 'br_yellow) :weight bold))))
        (mode-line-emphasis ((,class (:weight bold))))
        (header-line ((,class (:foreground ,(c 'fg_0) :background ,(c 'bg_1) :inherit nil))))
        (tab-bar ((,class (:foreground ,(c 'dim_0) :background ,(c 'bg_1)))))
        (tab-bar-tab ((,class (:foreground ,(c 'fg_1)
