        (ediff-current-diff-B ((,class (:foreground ,(c 'green) :background ,(c 'bg_1) :extend t))))
        (ediff-current-diff-C ((,class (:foreground ,(c 'yellow) :background ,(c 'bg_1) :extend t))))
        (ediff-current-diff-Ancestor ((,class (:foreground ,(c 'violet) :background ,(c 'bg_1) :extend t))))
        (ediff-fine-diff-A ((,class (:foreground ,(c 'br_red) :background ,(c 'bg_2)))))
        (ediff-fine-diff-B ((,class (:foreground ,(c 'br_green) :background ,(c 'bg_2)))))
        (ediff-fine-diff-C ((,class (:foreground ,(c 'br_yellow) :background ,(c 'bg_2)))))
        (ediff-fine-diff-Ancestor ((,class (:foreground ,(c 'br_violet) :background ,(c 'bg_2)))))
        (ediff-even-diff-A ((,class (:background ,(c 'bg_1) :extend t))))
        (ediff-even-diff-B ((,class (:background ,(c 'bg_1) :extend t))))
        (ediff-even-diff-C ((,class (:background ,(c 'bg_1) :extend t))))
        (ediff-even-diff-Ancestor ((,class (:background ,(c 'bg_1) :extend t))))
        (ediff-odd-diff-A ((,class (:background ,(c 'bg_2) :extend t))))
        (ediff-odd-diff-B ((,class (:background ,(c 'bg_2) :extend t))))
        (ediff-odd-diff-C ((,class (:background ,(c 'bg_2) :extend t))))
        (ediff-odd-diff-Ancestor ((,class (:background ,(c 'bg_2) :extend t))))

        ;; ANSI / term / eshell
        (term ((,class (:foreground ,(c 'fg_0) :background ,(c 'bg_0)))))
        (term-bold ((,class (:weight bold))))
        (term-color-black ((,class (:foreground ,(c 'bg_1) :background ,(c 'bg_1)))))
        (term-color-red ((,class (:foreground ,(c 'red) :background ,(c 'red)))))
        (term-color-green ((,class (:foreground ,(c 'green) :background ,(c 'green)))))
        (term-color-yellow ((,class (:foreground ,(c 'yellow) :background ,(c 'yellow)))))
        (term-color-blue ((,class (:foreground ,(c 'blue) :background ,(c 'blue)))))
        (term-color-magenta ((,class (:foreground ,(c 'magenta) :background ,(c 'magenta)))))
        (term-color-cyan ((,class (:foreground ,(c 'cyan) :background ,(c 'cyan)))))
        (term-color-white ((,class (:foreground ,(c 'dim_0) :background ,(c 'dim_0)))))
        (term-color-bright-black ((,class (:foreground ,(c 'bg_2) :background ,(c 'bg_2)))))
        (term-color-bright-red ((,class (:foreground ,(c 'br_red) :background ,(c 'br_red)))))
        (term-color-bright-green ((,class (:foreground ,(c 'br_green) :background ,(c 'br_green)))))
        (term-color-bright-yellow ((,class (:foreground ,(c 'br_yellow) :background ,(c 'br_yellow)))))
        (term-color-bright-blue ((,class (:foreground ,(c 'br_blue) :background ,(c 'br_blue)))))
        (term-color-bright-magenta ((,class (:foreground ,(c 'br_magenta) :background ,(c 'br_magenta)))))
        (term-color-bright-cyan ((,class (:foreground ,(c 'br_cyan) :background ,(c 'br_cyan)))))
        (term-color-bright-white ((,class (:foreground ,(c 'fg_1) :background ,(c 'fg_1)))))
        (ansi-color-black ((,class (:foreground ,(c 'bg_1) :background ,(c 'bg_1)))))
        (ansi-color-red ((,class (:foreground ,(c 'red) :background ,(c 'red)))))
        (ansi-color-green ((,class (:foreground ,(c 'green) :background ,(c 'green)))))
        (ansi-color-yellow ((,class (:foreground ,(c 'yellow) :background ,(c 'yellow)))))
        (ansi-color-blue ((,class (:foreground ,(c 'blue) :background ,(c 'blue)))))
        (ansi-color-magenta ((,class (:foreground ,(c 'magenta) :background ,(c 'magenta)))))
        (ansi-color-cyan ((,class (:foreground ,(c 'cyan) :background ,(c 'cyan)))))
        (ansi-color-white ((,class (:foreground ,(c 'dim_0) :background ,(c 'dim_0)))))
