        (tab-line-tab ((,class (:foreground ,(c 'fg_1) :background ,(c 'bg_0)))))
        (tab-line-tab-inactive ((,class (:foreground ,(c 'dim_0) :background ,(c 'bg_1)))))
        (tab-line-tab-current ((,class (:foreground ,(c 'fg_1)
