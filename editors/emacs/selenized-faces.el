        (font-lock-warning-face ((,class (:foreground ,(c 'red) :weight bold))))
        (font-lock-negation-char-face ((,class (:foreground ,(c 'red)))))
        (font-lock-regexp-grouping-backslash ((,class (:foreground ,(c 'red)))))
        (font-lock-regexp-grouping-construct ((,class (:foreground ,(c 'yellow)))))
        (font-lock-escape-face ((,class (:foreground ,(c 'red)))))
        (font-lock-regexp-face ((,class (:foreground ,(c 'magenta)))))
        (font-lock-operator-face ((,class (:foreground ,(c 'br_yellow)))))
        (font-lock-property-name-face ((,class (:foreground ,(c 'blue)))))
        (font-lock-property-use-face ((,class (:foreground ,(c 'blue)))))
        (font-lock-punctuation-face ((,class (:foreground ,(c 'fg_0)))))
