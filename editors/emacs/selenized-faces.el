        ;; Whitespace
        (whitespace-space ((,class (:foreground ,(c 'bg_2)))))
        (whitespace-hspace ((,class (:foreground ,(c 'bg_2)))))
        (whitespace-tab ((,class (:foreground ,(c 'bg_2) :background ,(c 'bg_1)))))
        (whitespace-newline ((,class (:foreground ,(c 'bg_2)))))
        (whitespace-trailing ((,class (:foreground ,(c 'red) :background ,(c 'bg_1)))))
        (whitespace-line ((,class (:foreground ,(c 'magenta) :background ,(c 'bg_1)))))
        (whitespace-empty ((,class (:background ,(c 'bg_1)))))
        (whitespace-indentation ((,class (:foreground ,(c 'bg_2) :background ,(c 'bg_1)))))
