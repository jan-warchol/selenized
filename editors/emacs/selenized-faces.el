        (diff-changed ((,class (:foreground ,(c 'yellow) :background ,(c 'bg_1) :extend t))))
        (diff-refine-added ((,class (:foreground ,(c 'br_green) :background ,(c 'bg_2)))))
        (diff-refine-removed ((,class (:foreground ,(c 'br_red) :background ,(c 'bg_2)))))
        (diff-refine-changed ((,class (:foreground ,(c 'br_yellow) :background ,(c 'bg_2)))))
        (diff-header ((,class (:foreground ,(c 'fg_0) :background ,(c 'bg_2) :extend t))))
        (diff-file-header ((,class (:foreground ,(c 'fg_1)
                                                :background ,(c 'bg_2)
                                                :weight bold
                                                :extend t))))
        (diff-hunk-header ((,class (:foreground ,(c 'br_yellow) :background ,(c 'bg_1) :extend t))))
        (diff-function ((,class (:foreground ,(c 'br_blue)))))
        (diff-index ((,class (:foreground ,(c 'violet)))))
